{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accountsweep:schema:recipe:v1",
  "title": "AccountSweep site recipe",
  "description": "A site recipe (written in TOML, validated as JSON after parsing). Recipes contain no secrets. Code adds checks the schema can't express, such as every URL host matching `site`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "name", "last_verified", "agent_clicks", "actions"],
  "properties": {
    "site": {
      "description": "Registrable domain of the site, lowercase.",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "maxLength": 253
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "last_verified": {
      "description": "Date a human last checked these steps against the live site (YYYY-MM-DD, quoted in TOML).",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "agent_clicks": {
      "description": "true: the agent may click through approved actions. false: guided only; the agent opens the page and the user clicks.",
      "type": "boolean"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "logout": { "$ref": "#/$defs/action" },
        "revoke": { "$ref": "#/$defs/action" },
        "delete": {
          "allOf": [
            { "$ref": "#/$defs/action" },
            {
              "required": ["final_click"],
              "properties": { "final_click": { "const": "user" } }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "stop_if": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["sign_in", "password", "two_factor", "captcha", "payment", "different_account", "unexpected_warning"] }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "steps", "success"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^\\s/]+(/\\S*)?$", "maxLength": 500 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "success": { "type": "string", "minLength": 1, "maxLength": 300 },
        "stop_if": { "$ref": "#/$defs/stop_if" },
        "fallback": { "type": "string", "maxLength": 300 },
        "final_click": { "enum": ["user", "agent"] }
      }
    }
  }
}
